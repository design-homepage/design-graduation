.vercel/

# Exclude everything in public/ except the files we need
public/*
!public/work/
public/work/*
!public/work/work_all/
public/work/work_all/*
!public/work/work_all/*/
public/work/work_all/*/*
!public/work/work_all/*/*.webp
!public/work/work_all/*/*.gif
!public/work/work_all/*/*.png
!public/work/work_all/*/*.jpg
!public/work/work_all/*/*.jpeg

